---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Shown above the options and read out as the group's name. */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div role="group" data-part="group" class={cn("flex flex-col", className)}>
  <div data-part="group-label" class="px-2.5 pt-1.5 pb-1 text-xs font-medium text-muted select-none">
    {label}
  </div>
  <slot />
</div>
