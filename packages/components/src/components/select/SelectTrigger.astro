---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Shown while nothing is chosen. */
  placeholder?: string;
  /** Accessible name for a select with no SelectLabel. */
  "aria-label"?: string;
  class?: string;
}

const { placeholder = "Select", "aria-label": ariaLabel, class: className } = Astro.props;
---

<button
  type="button"
  role="combobox"
  data-part="trigger"
  aria-haspopup="listbox"
  aria-expanded="false"
  aria-label={ariaLabel}
  data-state="closed"
  class={cn(
    "eris-curve flex h-11 w-full cursor-pointer items-center justify-between gap-3 rounded-field border border-border bg-field px-3.5 text-left text-[15px] text-foreground",
    "transition-colors duration-(--eris-duration-state) ease-eris hover:border-border-strong data-[state=open]:border-border-strong",
    "outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
    "aria-invalid:border-danger disabled:cursor-default disabled:opacity-40 disabled:hover:border-border",
    className,
  )}
>
  {/* Hidden until the script has put the starting value's text in, so the placeholder does not flash. */}
  <span
    data-part="value-text"
    data-placeholder={placeholder}
    data-placeholder-shown
    class="truncate data-placeholder-shown:text-muted group-[[data-default-value]:not([data-ready])]/select:invisible"
  >
    {placeholder}
  </span>
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4 shrink-0 text-muted"
  >
    <path d="m5 6 3-3 3 3M5 10l3 3 3-3"></path>
  </svg>
</button>
