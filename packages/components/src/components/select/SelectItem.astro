---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Sent with the form and reported by the hidden select. Must be unique in the select. */
  value: string;
  disabled?: boolean;
  class?: string;
}

const { value, disabled = false, class: className } = Astro.props;
---

<div
  role="option"
  aria-selected="false"
  data-part="item"
  data-value={value}
  data-item-disabled={disabled ? "" : undefined}
  class={cn(
    "flex min-h-9 cursor-pointer items-center justify-between gap-3 rounded-[10px] px-2.5 py-1.5 text-sm text-foreground outline-none select-none",
    "data-highlighted:bg-(--eris-highlight) data-disabled:cursor-default data-disabled:text-(--eris-disabled)",
    className,
  )}
>
  <span data-part="item-text">
    <slot />
  </span>
  <span data-part="item-indicator" hidden class="shrink-0">
    <svg
      aria-hidden="true"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="m3.5 8.5 3 3 6-7"></path>
    </svg>
  </span>
</div>
