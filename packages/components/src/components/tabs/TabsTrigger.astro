---
import { cn } from "@/lib/eris/utils";

interface Props {
  value: string;
  disabled?: boolean;
  class?: string;
}

const { value, disabled = false, class: className } = Astro.props;
---

<button
  type="button"
  role="tab"
  data-part="trigger"
  data-value={value}
  disabled={disabled}
  class={cn(
    "eris-curve inline-flex h-8 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-pill px-3.5 text-sm font-medium text-muted",
    "transition-colors duration-(--eris-duration-state) ease-eris hover:text-foreground data-selected:text-foreground",
    "outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
    "disabled:pointer-events-none disabled:opacity-40 [&_svg]:size-4",
    className,
  )}
>
  <slot />
</button>
