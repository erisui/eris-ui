---
import { cn } from "@/lib/eris/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  data-part="content"
  class={cn(
    "pb-4 text-[15px] text-muted data-[state=open]:animate-[eris-fade-in_var(--eris-duration-open)_var(--eris-ease)]",
    className,
  )}
>
  <slot />
</div>
