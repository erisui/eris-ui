---
import type { HTMLAttributes } from "astro/types";
import { buttonVariants, type ButtonSize, type ButtonVariant } from "./variants";

type Props = (HTMLAttributes<"button"> | HTMLAttributes<"a">) & {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
};

const { variant, size, href, class: className, ...rest } = Astro.props;
const classes = buttonVariants({ variant, size, class: className as string | undefined });
// Taken out of the spread: a second `type` attribute in the HTML would be ignored.
const { type = "button", ...buttonRest } = rest as HTMLAttributes<"button">;
---

{href ? (
  <a href={href} class={classes} {...(rest as HTMLAttributes<"a">)}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...buttonRest}>
    <slot />
  </button>
)}
