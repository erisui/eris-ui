{
  // Static site on Cloudflare Workers. CI deploys it on every push to main (the deploy job in .github/workflows/ci.yml).
  // By hand, from the repo root: `pnpm turbo run build --filter=www`, then `pnpm --filter www run deploy`
  // (plain `pnpm deploy` is a pnpm built-in).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erisui-www",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Serve only on the custom domains. Without these, every deploy turns the workers.dev URLs back on.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "erisui.dev", "custom_domain": true },
    { "pattern": "www.erisui.dev", "custom_domain": true },
  ],
}
