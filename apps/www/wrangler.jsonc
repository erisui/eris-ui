{
  // Static site on Cloudflare Workers. From the repo root: `pnpm turbo run build --filter=www`, then `pnpm --filter www run deploy` (plain `pnpm deploy` is a pnpm built-in).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erisui-www",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
