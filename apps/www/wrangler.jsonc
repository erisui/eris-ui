{
  // Static site on Cloudflare Workers. CI deploys it on every push to main (the deploy job in .github/workflows/ci.yml).
  // By hand, from the repo root: `pnpm turbo run build --filter=www`, then `pnpm --filter www run deploy`
  // (plain `pnpm deploy` is a pnpm built-in).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erisui-www",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // The site is served only on erisui.dev and www.erisui.dev, attached as custom domains in the Cloudflare
  // dashboard (the CI token can't manage them). Without these two lines, every deploy turns the
  // workers.dev URLs back on.
  "workers_dev": false,
  "preview_urls": false,
}
