---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import TableCell from "../../components/TableCell.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, status } = entry.data;
---

<Docs title={title} description={description}>
  <div class="not-prose mb-8 flex flex-col gap-3">
    <div class="flex items-center gap-3">
      <h1 class="text-[32px] leading-tight font-semibold tracking-[-0.03em] text-foreground">{title}</h1>
      {status === "beta" && (
        <span class="eris-curve rounded-pill border border-border px-2.5 py-0.5 text-xs text-muted">
          Beta
        </span>
      )}
    </div>
    <p class="text-[17px] leading-relaxed text-muted">{description}</p>
  </div>
  <Content components={{ td: TableCell }} />
</Docs>
