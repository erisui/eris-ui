---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CodeBlock from "../components/CodeBlock.astro";
import ShowcaseTile from "../components/ShowcaseTile.astro";
import ProBackdrop from "../components/ProBackdrop.astro";
import { LINKS, cliCommand } from "../const";
import { docsNav } from "../nav";
import Button from "@/components/ui/button/Button.astro";
import Dialog from "@/components/ui/dialog/Dialog.astro";
import DialogTrigger from "@/components/ui/dialog/DialogTrigger.astro";
import DialogContent from "@/components/ui/dialog/DialogContent.astro";
import DialogTitle from "@/components/ui/dialog/DialogTitle.astro";
import DialogDescription from "@/components/ui/dialog/DialogDescription.astro";
import DialogClose from "@/components/ui/dialog/DialogClose.astro";
import Tabs from "@/components/ui/tabs/Tabs.astro";
import TabsList from "@/components/ui/tabs/TabsList.astro";
import TabsTrigger from "@/components/ui/tabs/TabsTrigger.astro";
import TabsContent from "@/components/ui/tabs/TabsContent.astro";
import Kbd from "@/components/ui/kbd/Kbd.astro";
import KbdGroup from "@/components/ui/kbd/KbdGroup.astro";
import Accordion from "@/components/ui/accordion/Accordion.astro";
import AccordionItem from "@/components/ui/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/ui/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/ui/accordion/AccordionContent.astro";
import Switch from "@/components/ui/switch/Switch.astro";
import Checkbox from "@/components/ui/checkbox/Checkbox.astro";
import Popover from "@/components/ui/popover/Popover.astro";
import PopoverTrigger from "@/components/ui/popover/PopoverTrigger.astro";
import PopoverContent from "@/components/ui/popover/PopoverContent.astro";
import PopoverTitle from "@/components/ui/popover/PopoverTitle.astro";
import PopoverDescription from "@/components/ui/popover/PopoverDescription.astro";
import PopoverClose from "@/components/ui/popover/PopoverClose.astro";
import Tooltip from "@/components/ui/tooltip/Tooltip.astro";
import Snippet from "@/components/ui/snippet/Snippet.astro";
import FactIcon, { type FactIconName } from "../components/FactIcon.astro";

/** Documented components, so the hero badge count follows the docs nav. */
const componentCount = docsNav.find((s) => s.title === "Components")?.items.length ?? 0;

const facts: { title: string; body: string; icon: FactIconName }[] = [
  {
    title: "Keyboard and focus from Zag",
    body: "Zag state machines handle arrow keys, Escape, focus traps and ARIA attributes. Each component follows its WAI-ARIA pattern.",
    icon: "keyboard",
  },
  {
    title: "Plain .astro files you own",
    body: "The CLI copies each component into src/components/ui, so you can edit it freely. The diff command shows what changed upstream since you copied it.",
    icon: "file-code",
  },
  {
    title: "No framework islands",
    body: "Each component ships one small script that adds behaviour to the server-rendered HTML. The page loads no React, Vue or Svelte runtime.",
    icon: "feather",
  },
  {
    title: "Works with view transitions",
    body: "Components start on each page load and clean up before Astro swaps the page, so nothing leaks between pages.",
    icon: "arrow-left-right",
  },
];
---

<Base>
  <Header />
  <main id="main">
    <section class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-6 pt-24 pb-20">
      <span class="eris-curve rounded-pill border border-border px-3 py-1 text-xs text-muted">
        Beta · {componentCount} components
      </span>
      <h1 class="max-w-3xl text-5xl leading-[1.05] font-semibold tracking-[-0.04em] text-balance md:text-6xl">
        Accessible UI components you can drop into any Astro project.
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-muted">
        Plain <code class="font-mono text-[0.9em] text-ghost">.astro</code> files styled with Tailwind v4.
        Zag handles keyboard, focus and ARIA without a framework island.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="/docs/installation" size="lg">
          Get started
        </Button>
        <Button href="/docs/components/button" size="lg" variant="secondary">
          Browse components
        </Button>
      </div>
      <div class="w-full max-w-md">
        <CodeBlock lang="sh" code={cliCommand("init")} />
      </div>
    </section>

    <section aria-label="Live examples" class="mx-auto max-w-6xl px-6 pb-24">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <ShowcaseTile name="Button" href="/docs/components/button">
          <Button>Button</Button>
        </ShowcaseTile>

        <ShowcaseTile name="Tabs" href="/docs/components/tabs" class="lg:col-span-2">
          <Tabs id="home-tabs" class="items-center text-center">
            <TabsList aria-label="Example">
              <TabsTrigger value="preview">Preview</TabsTrigger>
              <TabsTrigger value="code">Code</TabsTrigger>
              <TabsTrigger value="usage">Usage</TabsTrigger>
            </TabsList>
            <TabsContent value="preview" class="text-sm text-muted">
              The indicator slides to the selected tab.
            </TabsContent>
            <TabsContent value="code" class="text-sm text-muted">
              Each tab is a plain button with role="tab".
            </TabsContent>
            <TabsContent value="usage" class="text-sm text-muted">
              Home and End jump to the first and last tab.
            </TabsContent>
          </Tabs>
        </ShowcaseTile>

        <ShowcaseTile name="Kbd" href="/docs/components/kbd" class="lg:col-span-2">
          <dl class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-5 gap-y-3 text-sm">
            <dt><Kbd>Tab</Kbd></dt>
            <dd class="text-muted">Moves focus</dd>
            <dt>
              <KbdGroup><Kbd>Shift</Kbd><Kbd>Tab</Kbd></KbdGroup>
            </dt>
            <dd class="text-muted">Moves focus back</dd>
            <dt class="text-muted"><Kbd label="Right arrow">→</Kbd> / <Kbd label="Left arrow">←</Kbd></dt>
            <dd class="text-muted">Next or previous tab</dd>
            <dt><Kbd>Esc</Kbd></dt>
            <dd class="text-muted">Closes the dialog</dd>
          </dl>
        </ShowcaseTile>

        <ShowcaseTile name="Dialog" href="/docs/components/dialog">
          <Dialog id="home-dialog">
            <DialogTrigger>Open dialog</DialogTrigger>
            <DialogContent>
              <div class="flex flex-col gap-1.5">
                <DialogTitle>Create project</DialogTitle>
                <DialogDescription>Focus stays inside until you close this.</DialogDescription>
              </div>
              <div class="flex justify-end gap-2">
                <DialogClose>Cancel</DialogClose>
                <DialogClose variant="primary">Create</DialogClose>
              </div>
            </DialogContent>
          </Dialog>
        </ShowcaseTile>

        <!-- Two rows tall on wide screens, so opening an item never changes the tile's height. -->
        <ShowcaseTile name="Accordion" href="/docs/components/accordion" class="md:col-span-2 lg:row-span-2">
          <Accordion id="home-accordion" class="max-w-md">
            <AccordionItem value="framework" open>
              <AccordionTrigger>Does it work without a framework?</AccordionTrigger>
              <AccordionContent>Yes. Every component is a plain .astro file with a small script.</AccordionContent>
            </AccordionItem>
            <AccordionItem value="styles">
              <AccordionTrigger>Can I change the styles?</AccordionTrigger>
              <AccordionContent>The code is copied into your project, so edit the classes freely.</AccordionContent>
            </AccordionItem>
            <AccordionItem value="license">
              <AccordionTrigger>What is the license?</AccordionTrigger>
              <AccordionContent>MIT. Use it in personal and commercial projects.</AccordionContent>
            </AccordionItem>
          </Accordion>
        </ShowcaseTile>

        <ShowcaseTile name="Switch" href="/docs/components/switch">
          <Switch id="home-switch" checked>Email notifications</Switch>
        </ShowcaseTile>

        <ShowcaseTile name="Checkbox" href="/docs/components/checkbox">
          <Checkbox id="home-checkbox" checked>Remember me on this device</Checkbox>
        </ShowcaseTile>

        <ShowcaseTile name="Popover" href="/docs/components/popover">
          <Popover id="home-popover">
            <PopoverTrigger>Share</PopoverTrigger>
            <PopoverContent>
              <PopoverTitle>Share this page</PopoverTitle>
              <PopoverDescription>Anyone with the link can view it.</PopoverDescription>
              <div class="flex gap-2">
                <Button size="sm">Copy link</Button>
                <PopoverClose>Done</PopoverClose>
              </div>
            </PopoverContent>
          </Popover>
        </ShowcaseTile>

        <ShowcaseTile name="Tooltip" href="/docs/components/tooltip">
          <Tooltip id="home-tooltip" text="Copy the link to this page">
            <Button variant="secondary">Copy link</Button>
          </Tooltip>
        </ShowcaseTile>

        <ShowcaseTile name="Snippet" href="/docs/components/snippet" class="px-4 md:col-span-2 lg:col-span-1">
          <Snippet id="home-snippet" code={cliCommand("init")} />
        </ShowcaseTile>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="grid gap-x-12 gap-y-12 md:grid-cols-2">
        {facts.map((f) => (
          <div class="flex flex-col items-start">
            <span class="eris-curve mb-5 grid size-10 place-items-center rounded-field border border-border bg-raised text-foreground shadow-[inset_0_1px_0_rgb(255_255_255/0.05)]">
              <FactIcon name={f.icon} class="size-[18px]" />
            </span>
            <h2 class="text-base font-semibold tracking-[-0.01em]">{f.title}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="pro-heading" class="mx-auto max-w-6xl px-6 pb-28">
      <div class="eris-curve relative isolate overflow-hidden rounded-card border border-border bg-surface px-6 py-16 text-center md:py-20">
        <ProBackdrop />

        <div class="mx-auto flex max-w-xl flex-col items-center gap-5">
          <p class="text-[13px] font-medium text-[#a9c0fa]">Eris Pro · Coming later</p>
          <h2 id="pro-heading" class="text-3xl leading-[1.1] font-semibold tracking-[-0.03em] text-balance md:text-4xl">
            Ready made page sections built from the same components.
          </h2>
          <p class="text-[15px] leading-relaxed text-pretty text-muted">
            Pricing tables, settings pages and dashboards that you add with the same CLI.
          </p>
          <Button href={LINKS.githubOrg} variant="accent" size="lg" class="mt-3 whitespace-nowrap">
            Follow on GitHub
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
