---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "@/components/ui/button/Button.astro";
---

<Base title="Page not found">
  <div class="flex min-h-svh flex-col">
    <Header />
    <main id="main" class="site-container flex flex-1 flex-col items-start justify-center py-20">
      <h1 class="text-4xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">This page does not exist.</h1>
      <p class="mt-3 font-mono text-sm text-muted">HTTP 404</p>
      <Button href="/docs" class="mt-7">Go to the docs</Button>
    </main>
    <Footer />
  </div>
</Base>
