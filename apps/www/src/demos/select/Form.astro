---
import Select from "@/components/ui/select/Select.astro";
import SelectLabel from "@/components/ui/select/SelectLabel.astro";
import SelectTrigger from "@/components/ui/select/SelectTrigger.astro";
import SelectContent from "@/components/ui/select/SelectContent.astro";
import SelectItem from "@/components/ui/select/SelectItem.astro";
import Button from "@/components/ui/button/Button.astro";
---

<form id="demo-select-form" class="flex w-64 flex-col items-start gap-4">
  <Select name="plan" value="pro" class="w-full">
    <SelectLabel>Plan</SelectLabel>
    <SelectTrigger />
    <SelectContent>
      <SelectItem value="free">Free</SelectItem>
      <SelectItem value="pro">Pro</SelectItem>
      <SelectItem value="team">Team</SelectItem>
    </SelectContent>
  </Select>
  <Select name="region" required class="w-full">
    <SelectLabel>Region</SelectLabel>
    <SelectTrigger placeholder="Pick a region" />
    <SelectContent>
      <SelectItem value="eu">Europe</SelectItem>
      <SelectItem value="us">United States</SelectItem>
    </SelectContent>
  </Select>
  <div class="flex gap-3">
    <Button type="submit" size="sm">
      Save
    </Button>
    <Button type="reset" size="sm" variant="secondary">
      Reset
    </Button>
  </div>
  <output class="text-sm text-muted"></output>
</form>

<script>
  // Shows what the form would send, instead of reloading the page.
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("#demo-select-form");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      form.querySelector("output")!.textContent = `Sent: ${data.toString() || "(nothing)"}`;
    });
    form?.addEventListener("reset", () => {
      form.querySelector("output")!.textContent = "";
    });
  });
</script>
