---
import { THEME_STORAGE_KEY } from "../const";
---

<!-- Flips between the dark and light theme and remembers the choice. The icon shows the theme you would switch to;
     which one shows is plain CSS on the html attribute, so it is right before any script runs. -->
<button type="button" class="theme-toggle" data-theme-toggle data-storage-key={THEME_STORAGE_KEY} aria-label="Switch to light theme">
  <svg class="theme-toggle-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="theme-toggle-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 999px; color: var(--eris-ghost); cursor: pointer; }
  .theme-toggle:hover { background: var(--eris-raised); color: var(--eris-foreground); }
  .theme-toggle:focus-visible { outline: 2px solid var(--eris-ring); outline-offset: 2px; }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-toggle-moon { display: none; }
  :global([data-theme="light"]) .theme-toggle-sun { display: none; }
  :global([data-theme="light"]) .theme-toggle-moon { display: block; }
  @media (pointer: coarse), (max-width: 767px) {
    .theme-toggle { width: 44px; height: 44px; }
  }
</style>

<!-- The view-transition pseudo-elements hang off <html>, so these rules cannot be scoped to the component. -->
<style is:global>
  /* The old theme stays still underneath; the new one is clipped to a circle that grows from the toggle. */
  html[data-theme-reveal]::view-transition-old(root),
  html[data-theme-reveal]::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  html[data-theme-reveal]::view-transition-new(root) {
    animation: theme-reveal 500ms var(--eris-ease);
  }
  /* The new theme is drawn live inside the circle. Anything with a colour transition (buttons, links) would
     still be fading out of the old theme in there, so colours snap for the length of the reveal. */
  html[data-theme-reveal] *,
  html[data-theme-reveal] *::before,
  html[data-theme-reveal] *::after {
    transition: none !important;
  }
  @keyframes theme-reveal {
    from {
      clip-path: circle(0 at var(--theme-reveal-x) var(--theme-reveal-y));
    }
    to {
      clip-path: circle(var(--theme-reveal-radius) at var(--theme-reveal-x) var(--theme-reveal-y));
    }
  }
</style>

<script>
  // The theme itself is applied by the inline script in Base.astro, which answers the "eris:theme" event.
  const isLight = () => document.documentElement.dataset.theme === "light";
  const label = (button: HTMLButtonElement) =>
    button.setAttribute("aria-label", isLight() ? "Switch to dark theme" : "Switch to light theme");

  // Circular reveal: the new theme grows out of the toggle as a circle, over a snapshot of the old one.
  // Without view transitions, or with reduced motion, the theme just changes.
  let running: ViewTransition | undefined;
  function reveal(button: HTMLButtonElement, apply: () => void) {
    if (!document.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) return apply();
    const root = document.documentElement;
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    // Far enough to reach the corner of the viewport furthest from the toggle.
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty("--theme-reveal-x", `${x}px`);
    root.style.setProperty("--theme-reveal-y", `${y}px`);
    root.style.setProperty("--theme-reveal-radius", `${radius}px`);
    // Marks this as a theme change, so page navigation keeps its own transition.
    root.dataset.themeReveal = "";
    const transition = document.startViewTransition(apply);
    running = transition;
    transition.finished.finally(() => {
      // A second click skips the first transition; only the latest one cleans up.
      if (running !== transition) return;
      running = undefined;
      delete root.dataset.themeReveal;
      for (const name of ["x", "y", "radius"]) root.style.removeProperty(`--theme-reveal-${name}`);
    });
  }

  function wire() {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      label(button);
      // An empty data attribute reads as "", so test for the key, not its value.
      if ("wired" in button.dataset) return;
      button.dataset.wired = "";
      button.addEventListener("click", () => {
        const next = isLight() ? "dark" : "light";
        try {
          localStorage.setItem(button.dataset.storageKey!, next);
        } catch {
          // Storage can be blocked; the theme then lasts until the next page.
        }
        const apply = () => {
          document.dispatchEvent(new CustomEvent("eris:theme", { detail: next }));
          label(button);
        };
        reveal(button, apply);
      });
    });
  }
  document.addEventListener("astro:page-load", wire);
  wire();
</script>
