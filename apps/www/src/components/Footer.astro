---
import { LINKS, SITE } from "../const";
---

<footer class="border-t border-[#1f1f1f]">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-muted">
    <p>
      {SITE.name}. Made with <span aria-hidden="true">♥</span><span class="sr-only">love</span> for Astro.
    </p>
    <p>
      Built on{" "}
      <a href={LINKS.zag} class="text-ghost hover:text-foreground">
        Zag
      </a>
      {" and "}
      <a href={LINKS.tailwind} class="text-ghost hover:text-foreground">
        Tailwind CSS
      </a>
      .
    </p>
  </div>
</footer>
