---
import { LINKS } from "../const";
import Button from "@/components/ui/button/Button.astro";

// Plausible sample content for the previews. They are pictures of blocks, hidden from assistive tech.
const plans = [
  { name: "Hobby", price: "$0", featured: false },
  { name: "Pro", price: "$19", featured: true },
  { name: "Team", price: "$49", featured: false },
];
const sections = ["General", "Billing", "Members"];
const settings = [
  { label: "Email digests", enabled: true },
  { label: "Two-factor", enabled: true },
  { label: "Public profile", enabled: false },
];
const metrics = [
  { label: "Visits", value: "12,480" },
  { label: "Signups", value: "342" },
  { label: "Orders", value: "96" },
];
const months = [31, 45, 38, 58, 49, 70, 62, 82, 75, 93, 84, 100];
---

<section id="pro" aria-labelledby="pro-heading" class="pro-showcase site-container pb-20 lg:pb-32">
  <div class="text-center">
    <h2 id="pro-heading" class="pro-heading leading-[1.1] font-medium tracking-[-0.03em] text-foreground">
      <span class="block">Unique components</span>
      <span class="block">and page blocks</span>
    </h2>
    <p class="mt-4 text-sm text-muted">Eris Pro · Coming later</p>
    <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-pretty text-ghost sm:text-base">
      Full pricing sections, settings pages, dashboards, and harder interactive primitives you add with the
      same CLI. Plain <code class="font-mono text-[0.88em] text-ghost">.astro</code> files, still no framework
      islands.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={LINKS.githubOrg} variant="accent" size="lg">
        Follow on GitHub
      </Button>
      <Button href={`${LINKS.github}/discussions`} variant="secondary" size="lg">
        Suggest a block
      </Button>
    </div>
  </div>

  <ul class="pro-examples" role="list" aria-label="Example page blocks">
    <li class="pro-example">
      <span class="example-label">Pricing sections</span>
      <div class="plan-preview" aria-hidden="true">
        {plans.map((plan) => (
          <div class:list={["plan", { featured: plan.featured }]}>
            <span class="preview-meta">{plan.name}</span>
            <span class="preview-figure">{plan.price}<span class="preview-meta">/mo</span></span>
            <i class="plan-cta"></i>
          </div>
        ))}
      </div>
    </li>
    <li class="pro-example">
      <span class="example-label">Settings pages</span>
      <div class="settings-preview" aria-hidden="true">
        <div class="settings-sidebar">
          {sections.map((section, i) => (
            <span class:list={["preview-meta", { current: i === 0 }]}>{section}</span>
          ))}
        </div>
        <div class="settings-rows">
          {settings.map(({ label, enabled }) => (
            <div>
              <span class="preview-meta">{label}</span>
              <i class:list={["preview-toggle", { enabled }]}></i>
            </div>
          ))}
        </div>
      </div>
    </li>
    <li class="pro-example">
      <span class="example-label">Dashboards</span>
      <div class="dashboard-preview" aria-hidden="true">
        <div class="dashboard-metrics">
          {metrics.map(({ label, value }) => (
            <span>
              <span class="preview-meta">{label}</span>
              <span class="preview-figure">{value}</span>
            </span>
          ))}
        </div>
        <div class="dashboard-chart">
          {months.map((height) => (
            <i style={`--bar-size: ${height}%`}></i>
          ))}
        </div>
      </div>
    </li>
  </ul>
</section>

<style>
  .pro-showcase {
    container: pro-showcase / inline-size;
  }

  .pro-heading {
    font-size: clamp(1.75rem, 5.2cqi, 3.5rem);
  }

  .pro-examples {
    display: grid;
    gap: 0.75rem;
    margin-block-start: clamp(1.5rem, 4cqi, 2.75rem);
  }

  @container pro-showcase (min-width: 42rem) {
    .pro-examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pro-example {
    min-inline-size: 0;
    overflow: hidden;
    border: 1px solid var(--eris-border);
    border-radius: var(--eris-radius-field);
    background: var(--eris-background);
  }

  .example-label {
    display: block;
    padding: 0.625rem 0.875rem;
    border-block-end: 1px solid var(--eris-border);
    color: var(--eris-ghost);
    font: 0.75rem/1.4 var(--eris-font-mono);
  }

  .plan-preview,
  .settings-preview,
  .dashboard-preview {
    padding: clamp(0.625rem, 2cqi, 1rem);
  }

  /* Sample text inside the previews: small, muted, never below 11px. */
  .preview-meta {
    color: var(--eris-muted);
    font-size: 0.6875rem;
    line-height: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preview-figure {
    color: var(--eris-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .plan-preview,
  .dashboard-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .plan,
  .dashboard-metrics > span {
    display: grid;
    min-inline-size: 0;
    padding: 0.5rem;
    border: 1px solid var(--eris-border);
    border-radius: 0.375rem;
    background: var(--eris-surface);
  }

  .plan {
    gap: 0.25rem;
  }

  .plan.featured {
    border-color: var(--site-pro-accent);
  }

  .plan-cta {
    display: block;
    block-size: 0.75rem;
    margin-block-start: 0.25rem;
    border-radius: 0.25rem;
    background: var(--eris-raised);
    box-shadow: inset 0 0 0 1px var(--eris-border);
  }

  .plan.featured .plan-cta {
    background: var(--site-pro-accent);
    box-shadow: none;
  }

  .settings-preview {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.5rem;
  }

  .settings-sidebar {
    display: grid;
    align-content: start;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: 0.375rem;
    background: var(--eris-surface);
  }

  .settings-sidebar .preview-meta {
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
  }

  .settings-sidebar .current {
    background: var(--eris-raised);
    color: var(--eris-foreground);
  }

  .settings-rows {
    display: grid;
    gap: 0.375rem;
  }

  .settings-rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-inline-size: 0;
    padding: 0.25rem 0.375rem;
    border: 1px solid var(--eris-border);
    border-radius: 0.375rem;
  }

  .preview-toggle {
    display: flex;
    flex: none;
    inline-size: 1.25rem;
    padding: 2px;
    border-radius: 999px;
    background: var(--site-pro-track);
  }

  .preview-toggle::before {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--eris-ghost);
  }

  .preview-toggle.enabled {
    justify-content: end;
    background: var(--site-pro-accent);
  }

  .preview-toggle.enabled::before {
    background: #fff;
  }

  .dashboard-metrics > span {
    gap: 0.125rem;
  }

  /* Twelve months, neutral; the current month carries the accent. */
  .dashboard-chart {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: clamp(0.125rem, 0.5cqi, 0.375rem);
    block-size: 2.75rem;
    margin-block-start: 0.75rem;
    border-block-end: 1px solid var(--eris-border);
    background: repeating-linear-gradient(
      to top,
      transparent 0 calc(25% - 1px),
      var(--eris-border) calc(25% - 1px) 25%
    );
  }

  .dashboard-chart i {
    block-size: var(--bar-size);
    border-radius: 2px 2px 0 0;
    background: var(--site-pro-track);
    transform-origin: center bottom;
  }

  .dashboard-chart i:last-child {
    background: var(--site-pro-accent);
  }

  [data-preview="pending"] :is(.plan, .settings-rows > div, .dashboard-chart i) {
    opacity: 0;
  }

  [data-preview="shown"] :is(.plan, .settings-rows > div, .dashboard-chart i) {
    transition: opacity var(--eris-duration-open) var(--eris-ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-preview="pending"] .plan {
      transform: translateY(8px);
    }

    [data-preview="pending"] .dashboard-chart i {
      transform: scaleY(0.15);
    }

    [data-preview="shown"] :is(.plan, .dashboard-chart i) {
      transition-property: opacity, transform;
    }

    [data-preview="shown"] :is(.plan, .settings-rows > div):nth-child(2),
    [data-preview="shown"] .dashboard-chart i:nth-child(n + 5) {
      transition-delay: 50ms;
    }

    [data-preview="shown"] :is(.plan, .settings-rows > div):nth-child(3),
    [data-preview="shown"] .dashboard-chart i:nth-child(n + 9) {
      transition-delay: 100ms;
    }
  }
</style>

<script>
  function observePreviews() {
    if (!("IntersectionObserver" in window)) return;

    // Leave previews that are already visible (for example after a scroll restore) in place.
    const previews = Array.from(document.querySelectorAll<HTMLElement>(".pro-example:not([data-preview])"))
      .filter((preview) => preview.getBoundingClientRect().top >= window.innerHeight);
    if (!previews.length) return;

    const observer = new IntersectionObserver((entries) => {
      for (const { target, intersectionRatio } of entries) {
        if (intersectionRatio < 0.15) continue;
        target.setAttribute("data-preview", "shown");
        observer.unobserve(target);
      }
    }, { threshold: 0.15 });

    for (const preview of previews) {
      preview.dataset.preview = "pending";
      observer.observe(preview);
    }

    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  }

  document.addEventListener("astro:page-load", observePreviews);
  observePreviews();
</script>
