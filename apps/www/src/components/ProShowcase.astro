---
import { LINKS } from "../const";
import Button from "@/components/ui/button/Button.astro";
---

<section id="pro" aria-labelledby="pro-heading" class="pro-showcase site-container pb-20 lg:pb-32">
  <div class="text-center">
    <h2 id="pro-heading" class="pro-heading leading-[1.12] font-semibold tracking-[-0.04em] text-foreground">
      <span class="block">Unique components</span>
      <span class="mt-1.5 inline-block">
        and <span class="text-(--site-pro-label)">page blocks.</span>
      </span>
    </h2>
    <p class="mt-4 text-sm font-medium text-(--site-pro-label)">Eris Pro · Coming later</p>
    <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-pretty text-ghost sm:text-base">
      Full pricing sections, settings pages, dashboards, and harder interactive primitives you add with the
      same CLI. Plain <code class="font-mono text-[0.88em] text-ghost">.astro</code> files, still no framework
      islands.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={LINKS.githubOrg} variant="accent" size="lg">
        Follow on GitHub
      </Button>
      <Button href={`${LINKS.github}/discussions`} variant="secondary" size="lg">
        Suggest a block
      </Button>
    </div>
  </div>

  <ul class="pro-examples" role="list" aria-label="Example page blocks">
    <li class="pro-example">
      <span class="example-label">Pricing sections</span>
      <div class="plan-preview" aria-hidden="true">
        {[false, true, false].map((featured) => (
          <div class:list={["plan", { featured }]}>
            <i class="preview-line"></i>
            <i class="plan-price"></i>
            <i class="preview-line"></i>
          </div>
        ))}
      </div>
    </li>
    <li class="pro-example">
      <span class="example-label">Settings pages</span>
      <div class="settings-preview" aria-hidden="true">
        <div class="settings-sidebar">
          <i class="preview-line"></i>
          <i class="preview-line"></i>
          <i class="preview-line"></i>
        </div>
        <div class="settings-rows">
          {[true, false, false].map((enabled) => (
            <div>
              <i class="preview-line"></i>
              <i class:list={["preview-toggle", { enabled }]}></i>
            </div>
          ))}
        </div>
      </div>
    </li>
    <li class="pro-example">
      <span class="example-label">Dashboards</span>
      <div class="dashboard-preview" aria-hidden="true">
        <div class="dashboard-metrics">
          <span>
            <i class="preview-line"></i>
          </span>
          <span>
            <i class="preview-line"></i>
          </span>
          <span>
            <i class="preview-line"></i>
          </span>
        </div>
        <div class="dashboard-chart">
          {[31, 45, 38, 58, 49, 70, 62, 82, 75, 93, 84, 100].map((height) => (
            <i style={`--bar-size: ${height}%`}></i>
          ))}
        </div>
      </div>
    </li>
  </ul>
</section>

<style>
  .pro-showcase {
    container: pro-showcase / inline-size;
  }

  .pro-heading {
    font-size: clamp(1.75rem, 5.2cqi, 3.5rem);
  }

  .pro-examples {
    display: grid;
    gap: 0.75rem;
    margin-block-start: clamp(1.5rem, 4cqi, 2.75rem);
  }

  @container pro-showcase (min-width: 42rem) {
    .pro-examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pro-example {
    min-inline-size: 0;
    overflow: hidden;
    border: 1px solid var(--eris-border);
    border-radius: var(--eris-radius-field);
    background: var(--eris-background);
  }

  .example-label {
    display: block;
    padding: 0.625rem 0.875rem;
    border-block-end: 1px solid var(--eris-border);
    color: var(--eris-ghost);
    font: 0.75rem/1.4 var(--eris-font-mono);
  }

  .plan-preview,
  .settings-preview,
  .dashboard-preview {
    padding: clamp(0.625rem, 2cqi, 1.125rem);
  }

  .plan-preview,
  .dashboard-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .plan,
  .dashboard-metrics span {
    display: grid;
    gap: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--eris-border);
    border-radius: 0.375rem;
    background: var(--eris-surface);
  }

  .plan {
    align-content: center;
    min-block-size: 5rem;
  }

  .plan.featured {
    border-color: var(--site-pro-guide);
    background: var(--site-pro-frame-bg);
  }

  .preview-line,
  .plan-price {
    display: block;
    inline-size: 65%;
    block-size: 0.25rem;
    border-radius: 0.25rem;
    background: var(--site-pro-blueprint);
  }

  .plan-price {
    inline-size: 85%;
    block-size: 0.75rem;
    background: var(--site-pro-guide);
  }

  .settings-preview {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.625rem;
  }

  .settings-sidebar {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
    background: var(--eris-surface);
  }

  .settings-sidebar .preview-line:first-child {
    background: var(--site-pro-guide);
  }

  .settings-rows {
    display: grid;
    gap: 0.375rem;
  }

  .settings-rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.375rem;
    border: 1px solid var(--eris-border);
    border-radius: 0.375rem;
  }

  .preview-toggle {
    display: flex;
    flex: none;
    inline-size: 1.125rem;
    padding: 2px;
    border-radius: 999px;
    background: var(--site-pro-blueprint);
  }

  .preview-toggle::before {
    content: "";
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background: var(--eris-ghost);
  }

  .preview-toggle.enabled {
    justify-content: end;
    background: var(--site-pro-guide);
  }

  .dashboard-chart {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: clamp(0.125rem, 0.5cqi, 0.375rem);
    block-size: 2.75rem;
    margin-block-start: 0.75rem;
    border-block-end: 1px solid var(--eris-border);
    background: repeating-linear-gradient(
      to top,
      transparent 0 calc(25% - 1px),
      var(--eris-border) calc(25% - 1px) 25%
    );
  }

  .dashboard-chart i {
    block-size: var(--bar-size);
    border-radius: 0.25rem 0.25rem 0 0;
    background: linear-gradient(var(--eris-ring), var(--site-pro-guide));
    opacity: 0.55;
  }
</style>
