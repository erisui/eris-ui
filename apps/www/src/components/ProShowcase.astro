---
import { LINKS } from "../const";
import Button from "@/components/ui/button/Button.astro";

// Subtle geometric cell grid inside the upper-right wireframe block (purely abstract strokes).
const miniCells = Array.from({ length: 4 }, (_, row) =>
  Array.from({ length: 12 }, (_, col) => ({
    x: 846 + col * 16,
    y: 132 + row * 16,
    accent: (row * 7 + col * 3) % 5 === 0 || (row === 1 && col >= 5 && col <= 7),
  })),
).flat();
---

<section aria-labelledby="pro-heading" class="site-container pb-16 lg:pb-24">
  <div class="eris-curve pro-teaser relative isolate overflow-hidden rounded-card border border-border bg-surface">
    <!-- Atmospheric architectural block blueprint -->
    <div class="pro-ambient" aria-hidden="true"></div>
    <svg
      class="pro-blueprint"
      viewBox="0 -72 1104 624"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <!-- Faint layout grid columns -->
      <g class="bp-grid">
        <line x1="184" y1="-72" x2="184" y2="552" />
        <line x1="368" y1="-72" x2="368" y2="552" />
        <line x1="552" y1="-72" x2="552" y2="552" />
        <line x1="736" y1="-72" x2="736" y2="552" />
        <line x1="920" y1="-72" x2="920" y2="552" />
        <line x1="0" y1="120" x2="1104" y2="120" />
        <line x1="0" y1="360" x2="1104" y2="360" />
      </g>

      <!-- Subtle dashed blueprint alignment guides -->
      <g class="bp-guide">
        <line x1="258" y1="92" x2="368" y2="92" stroke-dasharray="3 4" />
        <line x1="736" y1="312" x2="796" y2="312" stroke-dasharray="3 4" />
        <rect x="255" y="89" width="6" height="6" />
        <rect x="793" y="309" width="6" height="6" />
      </g>

      <!-- Left wing: abstract modular section wireframes -->
      <g class="bp-stroke">
        <!-- Upper-left: two-column block silhouette -->
        <rect x="20" y="34" width="238" height="156" rx="16" />
        <line x1="20" y1="74" x2="258" y2="74" />
        <rect x="36" y="49" width="68" height="10" rx="5" />
        <rect x="206" y="47" width="36" height="14" rx="7" />
        <rect x="36" y="90" width="96" height="84" rx="10" />
        <rect x="146" y="90" width="96" height="84" rx="10" />

        <!-- Lower-left: sidebar + rows block silhouette -->
        <rect x="48" y="216" width="256" height="222" rx="16" />
        <line x1="122" y1="216" x2="122" y2="438" />
        <rect x="64" y="238" width="42" height="8" rx="4" />
        <rect x="64" y="258" width="42" height="14" rx="7" class="bp-soft-fill" />
        <rect x="64" y="284" width="36" height="8" rx="4" />
        <rect x="64" y="304" width="40" height="8" rx="4" />

        <line x1="142" y1="278" x2="284" y2="278" />
        <line x1="142" y1="330" x2="284" y2="330" />
        <line x1="142" y1="382" x2="284" y2="382" />
        <rect x="254" y="246" width="30" height="16" rx="8" />
        <rect x="254" y="298" width="30" height="16" rx="8" />
        <rect x="254" y="350" width="30" height="16" rx="8" />
      </g>

      <!-- Right wing: abstract data + card section wireframes -->
      <g class="bp-stroke">
        <!-- Upper-right: activity block silhouette -->
        <rect x="826" y="42" width="258" height="172" rx="16" />
        <rect x="844" y="60" width="68" height="44" rx="10" />
        <rect x="921" y="60" width="68" height="44" rx="10" />
        <rect x="998" y="60" width="68" height="44" rx="10" />
        {miniCells.map((cell) => (
          <rect
            x={cell.x}
            y={cell.y}
            width="11"
            height="11"
            rx="3"
            class={cell.accent ? "bp-accent-cell" : undefined}
          />
        ))}

        <!-- Lower-right: stacked modular block silhouette -->
        <rect x="796" y="240" width="268" height="196" rx="16" />
        <line x1="796" y1="286" x2="1064" y2="286" />
        <rect x="814" y="258" width="96" height="10" rx="5" />
        <rect x="1016" y="255" width="30" height="16" rx="8" />
        <rect x="814" y="304" width="232" height="32" rx="10" class="bp-soft-fill" />
        <rect x="814" y="346" width="232" height="32" rx="10" />
        <rect x="814" y="388" width="232" height="32" rx="10" />
      </g>
    </svg>

    <div class="pro-vignette" aria-hidden="true"></div>
    <div class="pro-edge" aria-hidden="true"></div>

    <!-- Subtle corner registration marks -->
    <span class="pro-cross pro-cross-tl" aria-hidden="true">
      +
    </span>
    <span class="pro-cross pro-cross-tr" aria-hidden="true">
      +
    </span>
    <span class="pro-cross pro-cross-bl" aria-hidden="true">
      +
    </span>
    <span class="pro-cross pro-cross-br" aria-hidden="true">
      +
    </span>

    <!-- Centered editorial teaser -->
    <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center px-5 py-14 text-center sm:px-6 md:py-20">
      <h2
        id="pro-heading"
        class="text-[28px] leading-[1.12] font-semibold tracking-[-0.04em] text-foreground sm:text-5xl md:text-[56px]"
      >
        <span class="block">Unique components</span>
        <span class="mt-1.5 inline-flex flex-wrap items-baseline justify-center gap-x-[0.26em]">
          <span>and</span>
          <span class="pro-frame">
            <span>page blocks.</span>
            <span class="pro-handle pro-h-tl" aria-hidden="true"></span>
            <span class="pro-handle pro-h-tr" aria-hidden="true"></span>
            <span class="pro-handle pro-h-bl" aria-hidden="true"></span>
            <span class="pro-handle pro-h-br" aria-hidden="true"></span>
            <span class="pro-dimension" aria-hidden="true">
              block.astro
            </span>
          </span>
        </span>
      </h2>

      <p class="mt-11 text-sm font-medium text-(--site-pro-label)">Eris Pro · Coming later</p>
      <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-pretty text-ghost sm:text-base">
        Full pricing sections, settings pages, dashboards, and harder interactive primitives you add with the
        same CLI. Plain <code class="font-mono text-[0.88em] text-ghost">.astro</code> files, still no
        framework islands.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href={LINKS.githubOrg} variant="accent" size="lg" class="whitespace-nowrap">
          Follow on GitHub
        </Button>
        <Button href={`${LINKS.github}/discussions`} variant="secondary" size="lg" class="whitespace-nowrap">
          Suggest a block
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .pro-ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 52% 45% at 50% -14%, color-mix(in oklab, var(--eris-accent-top) 16%, transparent), transparent 72%),
      radial-gradient(ellipse 34% 48% at 92% 88%, color-mix(in oklab, var(--eris-accent-top) 8%, transparent), transparent 70%),
      radial-gradient(ellipse 30% 42% at 6% 85%, color-mix(in oklab, var(--eris-accent-top) 6%, transparent), transparent 70%);
  }

  .pro-blueprint {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pro-blueprint * {
    vector-effect: non-scaling-stroke;
  }

  .bp-grid {
    stroke: var(--site-pro-blueprint);
    stroke-width: 1;
    opacity: 0.35;
  }

  .bp-stroke {
    stroke: var(--site-pro-blueprint);
    stroke-width: 1;
  }

  .bp-soft-fill {
    fill: var(--site-pro-frame-bg);
  }

  .bp-accent-cell {
    stroke: var(--site-pro-guide);
    fill: var(--site-pro-frame-bg);
  }

  .bp-guide {
    stroke: var(--site-pro-guide);
    stroke-width: 1;
    fill: var(--eris-surface);
  }

  /* Soft radial clearance keeps the central copy sharp while revealing the wireframe blocks around it. */
  .pro-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 52% 62% at 50% 50%,
      color-mix(in oklab, var(--eris-surface) 92%, transparent) 0%,
      color-mix(in oklab, var(--eris-surface) 58%, transparent) 58%,
      transparent 100%
    );
  }

  .pro-edge {
    position: absolute;
    inset: 0 20% auto;
    z-index: 2;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--eris-accent-top) 42%, transparent), transparent);
  }

  .pro-cross {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    user-select: none;
    font-family: var(--eris-font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--eris-border-strong);
  }
  .pro-cross-tl {
    top: 16px;
    left: 18px;
  }
  .pro-cross-tr {
    top: 16px;
    right: 18px;
  }
  .pro-cross-bl {
    bottom: 16px;
    left: 18px;
  }
  .pro-cross-br {
    bottom: 16px;
    right: 18px;
  }

  /* Blueprint selection frame around "page blocks." */
  .pro-frame {
    position: relative;
    display: inline-block;
    padding: 0.04em 0.18em 0.1em;
    border: 1.5px solid var(--eris-ring);
    background: var(--site-pro-frame-bg);
    white-space: nowrap;
  }

  .pro-handle {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--eris-ring);
    background: var(--eris-surface);
  }
  .pro-h-tl {
    top: -4px;
    left: -4px;
  }
  .pro-h-tr {
    top: -4px;
    right: -4px;
  }
  .pro-h-bl {
    bottom: -4px;
    left: -4px;
  }
  .pro-h-br {
    bottom: -4px;
    right: -4px;
  }

  .pro-dimension {
    position: absolute;
    top: calc(100% + 9px);
    left: 50%;
    transform: translateX(-50%);
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--eris-accent-border);
    color: #fff;
    font-family: var(--eris-font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
    white-space: nowrap;
    box-shadow: 0 4px 12px var(--eris-button-shadow);
  }

  /* The wings fit beside the copy only at the card's full 1104px width (viewport 1152px+); narrower, they crop. */
  @media (max-width: 1151px) {
    .pro-blueprint {
      display: none;
    }
  }
</style>
