---
import { Code } from "astro:components";
import { CODE_THEMES } from "../const";

interface Props {
  code: string;
  lang?: "astro" | "ts" | "sh" | "css" | "json";
  title?: string;
}

const { code, lang = "astro", title } = Astro.props;
---

<!-- Code reads left to right on an RTL page too, so the block opts out of mirroring. -->
<div class="eris-code not-prose min-w-0" data-copy-root data-lang={lang} dir="ltr">
  {title && <div class="mb-2 font-mono text-xs text-muted">{title}</div>}
  <div class="eris-curve grid grid-cols-[minmax(0,1fr)_auto] items-start rounded-menu border border-border bg-(--site-code)">
    <Code code={code.trim()} lang={lang} themes={CODE_THEMES} defaultColor="dark" class="eris-pre" />
    <!-- Lucide "copy" and "check" icons, inlined so the docs site needs no icon package. -->
    <button
      type="button"
      data-copy
      aria-label="Copy code"
      class="group eris-curve m-1.5 grid size-10 place-items-center rounded-field text-muted hover:bg-raised hover:text-foreground focus-visible:outline-offset-[-2px] data-[copied]:text-foreground pointer-coarse:size-11"
    >
      <svg
        class="size-4 group-data-[copied]:hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg
        class="hidden size-4 group-data-[copied]:block"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
  </div>
  <p data-copy-status role="status" class="sr-only mt-2 text-xs text-muted"></p>
</div>

<style is:global>
  .eris-pre {
    font-family: var(--eris-font-mono);
    font-size: 13px;
    line-height: 1.65;
    padding: 15px 1rem;
    padding-inline-end: 0.5rem;
    border-radius: var(--eris-radius-menu);
    background: var(--site-code) !important;
    overflow-x: auto;
  }
  /* Shell prompt. Generated content stays out of innerText and selection,
     so the copy button and a manual select both get the bare command. */
  .eris-code[data-lang="sh"] .eris-pre .line:not(:empty)::before {
    content: "$ ";
    color: var(--eris-muted);
    user-select: none;
  }
  @supports (corner-shape: superellipse(1.25)) {
    .eris-pre {
      corner-shape: superellipse(1.25);
    }
  }
</style>

<script>
  function wire() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = "";
      const root = btn.closest("[data-copy-root]");
      const status = root?.querySelector<HTMLElement>("[data-copy-status]");
      let timer: ReturnType<typeof setTimeout> | undefined;
      const show = (copied: boolean, message = "", visible = false) => {
        btn.toggleAttribute("data-copied", copied);
        btn.setAttribute("aria-label", copied ? "Copied" : "Copy code");
        if (status) {
          status.classList.toggle("sr-only", !visible);
          status.textContent = message;
        }
      };
      btn.addEventListener("click", async () => {
        const code = root?.querySelector("pre")?.innerText ?? "";
        clearTimeout(timer);
        try {
          await navigator.clipboard.writeText(code);
          show(true, "Copied");
          timer = setTimeout(() => show(false), 1500);
        } catch {
          show(false, "Couldn’t copy. Select the code to copy it manually.", true);
        }
      });
    });
  }
  document.addEventListener("astro:page-load", wire);
  wire();
</script>
