---
import CodeBlock from "./CodeBlock.astro";
import Tabs from "@/components/ui/tabs/Tabs.astro";
import TabsList from "@/components/ui/tabs/TabsList.astro";
import TabsTrigger from "@/components/ui/tabs/TabsTrigger.astro";
import TabsContent from "@/components/ui/tabs/TabsContent.astro";

interface Props {
  /** Raw source of the demo file, from a `?raw` import. */
  source: string;
  id: string;
  /** Pro demos show the preview only. */
  hideCode?: boolean;
}

const { source, id, hideCode = false } = Astro.props;
// Show the demo the way a user writes it: drop the leading frontmatter fence if empty.
const code = source.replace(/^---\s*---\s*/, "");
const previewClass = "eris-curve flex min-h-40 items-center justify-center rounded-card border border-border bg-tile p-4 sm:min-h-52 sm:p-8";
---

<div class="not-prose my-6">
  {hideCode ? (
    <div
      class={previewClass}
      data-demo-preview
    >
      <slot />
    </div>
  ) : (
    <Tabs id={`demo-${id}`}>
      <TabsList aria-label="Demo view">
        <TabsTrigger value="preview">Preview</TabsTrigger>
        <TabsTrigger value="code">Code</TabsTrigger>
      </TabsList>
      <TabsContent value="preview">
        <div
          class:list={[previewClass, "flex-wrap content-center gap-3"]}
          data-demo-preview
        >
          <slot />
        </div>
      </TabsContent>
      <TabsContent value="code">
        <CodeBlock code={code} lang="astro" />
      </TabsContent>
    </Tabs>
  )}
</div>

<script>
  // Some demos scroll sideways on narrow screens (e.g. a long tab list). Roving focus moves without scrolling,
  // so bring the focused control into view inside that scroller only, never the page. Site-only: the demo
  // source users copy stays unchanged.
  const RING_ROOM = 4; // keep the 2px focus ring and its 2px offset visible
  document.addEventListener("focusin", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest("[data-demo-preview]")) return;
    let scroller = target.parentElement;
    while (scroller && !scroller.hasAttribute("data-demo-preview")) {
      const { overflowX } = getComputedStyle(scroller);
      if ((overflowX === "auto" || overflowX === "scroll") && scroller.scrollWidth > scroller.clientWidth)
        break;
      scroller = scroller.parentElement;
    }
    if (!scroller || scroller.hasAttribute("data-demo-preview")) return;
    const t = target.getBoundingClientRect();
    const s = scroller.getBoundingClientRect();
    if (t.left - RING_ROOM < s.left) scroller.scrollLeft -= s.left - t.left + RING_ROOM;
    else if (t.right + RING_ROOM > s.right) scroller.scrollLeft += t.right - s.right + RING_ROOM;
  });
</script>
