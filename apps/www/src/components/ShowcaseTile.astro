---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Component name, shown in the caption and linked to its docs page. */
  name: string;
  href: string;
  class?: string;
}

const { name, href, class: className } = Astro.props;
---

<div
  class={cn(
    "eris-curve grid min-h-44 min-w-0 grid-rows-[1fr_auto] rounded-card border border-border bg-tile sm:min-h-48",
    className,
  )}
>
  <div class="flex min-w-0 flex-wrap items-center justify-center gap-3 px-4 py-8 sm:px-6">
    <slot />
  </div>
  <p class="mx-4 flex border-t border-border py-1 sm:mx-5">
    <a href={href} class="site-demo-link py-1">
      {name}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3.5"><path d="M3 8h9m-3.5-3.5L12 8l-3.5 3.5" /></svg>
    </a>
  </p>
</div>
