---
import { cn } from "@/lib/eris/utils";

/**
 * A live readout of the state Zag keeps in the DOM, like `data-state="open"`.
 * `selector` finds the element(s) inside the tile, `attr` is read from them. With `many`, every match is listed.
 */
export interface TileState {
  selector: string;
  attr: string;
  /** The name shown in the readout. Defaults to `attr`. */
  label?: string;
  many?: boolean;
}

interface Props {
  /** Component name, shown in the caption and linked to its docs page. */
  name: string;
  href: string;
  state?: TileState;
  class?: string;
}

const { name, href, state, class: className } = Astro.props;
---

<div
  class={cn(
    "showcase-tile eris-curve grid min-h-40 min-w-0 grid-rows-[1fr_auto] rounded-card border border-border bg-tile sm:min-h-48",
    className,
  )}
  data-tile-state={state ? JSON.stringify(state) : undefined}
>
  <div class="flex min-w-0 flex-wrap items-center justify-center gap-3 px-4 py-8 sm:px-6">
    <slot />
  </div>
  <div class="mx-4 flex min-w-0 items-center justify-between gap-4 py-1 sm:mx-5">
    <a href={href} class="site-demo-link py-1">
      {name}
    </a>
    {state && (
      <code aria-hidden="true" class="tile-state truncate font-mono text-xs text-muted" dir="ltr"></code>
    )}
  </div>
</div>

<script>
  import type { TileState } from "./ShowcaseTile.astro";

  // Booleans like data-copied are present ("") or absent (null); everything else shows its value.
  const read = (el: Element, attr: string) => {
    const value = el.getAttribute(attr);
    return value === null ? "false" : value === "" ? "true" : value;
  };

  function mountTileStates() {
    const observers: MutationObserver[] = [];

    for (const tile of document.querySelectorAll<HTMLElement>("[data-tile-state]")) {
      const out = tile.querySelector<HTMLElement>(".tile-state");
      if (!out) continue;
      const state: TileState = JSON.parse(tile.dataset.tileState!);
      const label = state.label ?? state.attr;

      const render = () => {
        const matches = Array.from(tile.querySelectorAll(state.selector));
        const values = matches.map((el) => read(el, state.attr));
        out.textContent = state.many
          ? `${label}=[${values.map((v) => `"${v}"`).join(", ")}]`
          : `${label}="${values[0] ?? ""}"`;
      };

      render();
      const observer = new MutationObserver(render);
      observer.observe(tile, { subtree: true, attributes: true, attributeFilter: ["data-state", "aria-selected", "data-copied"] });
      observers.push(observer);
    }

    document.addEventListener("astro:before-swap", () => {
      for (const observer of observers) observer.disconnect();
    }, { once: true });
  }

  document.addEventListener("astro:page-load", mountTileStates);
</script>
