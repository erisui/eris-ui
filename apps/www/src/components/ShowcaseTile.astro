---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Component name, shown in the caption and linked to its docs page. */
  name: string;
  href: string;
  class?: string;
}

const { name, href, class: className } = Astro.props;
---

<div
  class={cn(
    "showcase-tile eris-curve grid min-h-44 min-w-0 grid-rows-[1fr_auto] rounded-card border border-border bg-tile sm:min-h-48",
    className,
  )}
>
  <div class="flex min-w-0 flex-wrap items-center justify-center gap-3 px-4 py-8 sm:px-6">
    <slot />
  </div>
  <p class="mx-4 flex py-1 sm:mx-5">
    <a href={href} class="site-demo-link py-1">
      {name}
    </a>
  </p>
</div>

<style>
  @media (hover: hover) and (pointer: fine) {
    .site-demo-link:not(:focus-visible) {
      transition: opacity 120ms var(--eris-ease);
    }

    .showcase-tile:not(:hover) .site-demo-link:not(:focus-visible) {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
