---
import { cn } from "@/lib/eris/utils";

interface Props {
  /** Component name, shown in the caption and linked to its docs page. */
  name: string;
  href: string;
  class?: string;
}

const { name, href, class: className } = Astro.props;
---

<!-- A bento tile: the live component sits centred in the whole tile. The caption is pinned to the bottom corner,
     and the equal block padding keeps the component clear of it without moving it off centre. -->
<div
  class={cn(
    "eris-curve relative flex min-h-64 min-w-0 rounded-card border border-border bg-tile px-6 py-14",
    className,
  )}
>
  <div class="flex min-w-0 flex-1 flex-wrap items-center justify-center gap-3">
    <slot />
  </div>
  <p class="absolute start-6 bottom-6 text-xs">
    <a
      href={href}
      class="font-medium text-ghost no-underline transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    >
      {name}
    </a>
  </p>
</div>
