---
import Mark from "../assets/eris-mark-currentcolor.svg";
const path = Astro.url.pathname;
const links = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/components/button", label: "Components" },
];
---

<header class="sticky top-0 z-40 border-b border-[#1f1f1f] bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-6">
    <a href="/" class="flex items-center gap-2.5 text-foreground" aria-label="Eris UI home">
      <Mark width={26} height={26} aria-hidden="true" />
      <span class="text-[17px] font-semibold tracking-[-0.03em]">
        eris <span class="font-normal text-muted">ui</span>
      </span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-6 text-sm">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "transition-colors hover:text-foreground",
            path.startsWith(l.href) && (l.href !== "/docs" || !path.startsWith("/docs/components"))
              ? "text-foreground"
              : "text-muted",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <a
      href="https://github.com/erisui/eris-ui"
      class="ml-auto text-sm text-muted transition-colors hover:text-foreground"
    >
      GitHub
    </a>
  </div>
</header>
