---
import Mark from "../assets/eris-mark-currentcolor.svg";
import GitHubMark from "../assets/github-currentcolor.svg";
import Search from "./Search.astro";
import { LINKS, SITE } from "../const";
const path = Astro.url.pathname;
const links = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/components/button", label: "Components" },
];
---

<header class="sticky top-0 z-40 px-2 pt-3 min-[375px]:px-4">
  <div class="relative mx-auto flex h-14 max-w-5xl items-center gap-2 rounded-pill border border-border px-4 py-1.5 min-[375px]:gap-3 sm:gap-6 sm:px-5 shadow-[0px_2px_3px_-1px_rgba(0,0,0,0.1),0px_1px_0px_0px_rgba(25,28,33,0.02),0px_0px_0px_1px_rgba(25,28,33,0.08)]">
    <!-- The blur lives on its own layer: backdrop-filter on the bar would trap the search dialog's fixed overlay inside it. -->
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 rounded-pill bg-page/75 backdrop-blur-md"
    ></div>
    <a href="/" class="-ms-1 flex items-center gap-2.5 text-foreground" aria-label={`${SITE.name} home`}>
      <Mark width={26} height={26} aria-hidden="true" />
      <span class="hidden text-[17px] font-semibold tracking-[-0.03em] whitespace-nowrap min-[375px]:inline">
        eris <span class="font-normal text-muted">ui</span>
      </span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-0.5 text-sm sm:gap-1">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "rounded-pill px-2.5 py-1.5 transition-colors sm:px-3.5 hover:text-foreground",
            path.startsWith(l.href) && (l.href !== "/docs" || !path.startsWith("/docs/components"))
              ? "bg-raised text-foreground"
              : "text-muted",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="ms-auto">
      <Search />
    </div>
    <a
      href={LINKS.github}
      class="-ms-1 inline-flex items-center gap-2 rounded-pill bg-raised px-2 py-1.5 sm:-ms-3 sm:px-3.5 text-sm text-ghost transition-colors hover:text-foreground"
    >
      <GitHubMark width={18} height={18} aria-hidden="true" />
      <span class="sr-only sm:not-sr-only">GitHub</span>
    </a>
  </div>
</header>
