---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Eris playground</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <nav class="flex flex-wrap gap-x-6 gap-y-3 border-b border-border px-6 py-5 text-sm text-muted sm:px-10">
      <a href="/" class="hover:text-foreground">
        Dialog
      </a>
      <a href="/tabs" class="hover:text-foreground">
        Tabs
      </a>
      <a href="/snippet" class="hover:text-foreground">
        Snippet
      </a>
      <a href="/kbd" class="hover:text-foreground">
        Kbd
      </a>
      <a href="/accordion" class="hover:text-foreground">
        Accordion
      </a>
      <a href="/switch" class="hover:text-foreground">
        Switch
      </a>
      <a href="/checkbox" class="hover:text-foreground">
        Checkbox
      </a>
      <a href="/popover" class="hover:text-foreground">
        Popover
      </a>
      <a href="/second" class="hover:text-foreground">
        Second page
      </a>
    </nav>
    <main class="mx-auto flex max-w-3xl flex-col gap-12 px-6 py-14 sm:px-10">
      <slot />
    </main>
  </body>
</html>
